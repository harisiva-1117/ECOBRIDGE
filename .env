# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK.
MAPS_API_KEY=DEFAULT_MAPS_API_KEY

# SUPABASE_URL: Your Supabase project URL, e.g. https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY: Public anon/public key from Supabase Project Settings -> API.
# Until real values are provided, all real auth flows surface an honest
# "Auth provider not configured" error (no simulated success).
SUPABASE_URL=https://xujqmjxnojnmpmmonhxe.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh1anFtanhub2pubXBtbW9uaHhlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkxMTM4NzEsImV4cCI6MjEwNDY4OTg3MX0.uhe6L8QJ6CSzfI71R3uFaKo2EXxDiEOgcfcYSzPcPZI

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web client id used for Google Sign-In via
# Credential Manager (id_token is exchanged with Supabase Sign In With ID Token).
GOOGLE_WEB_CLIENT_ID=991434806251-flc9qkb5tl8unbq29g02it06cp4ok5u4.apps.googleusercontent.com

# OTP_MODE: OTP delivery strategy. "demo" generates a random 6-digit OTP on-device,
# displays it in a clearly labelled Demo Mode banner and verifies it locally (no SMS).
# "sms" uses the real provider (Supabase / NestJS OTP service) and never exposes the code.
OTP_MODE=demo

# DEMO_OTP_PHONE: the only mobile number accepted for the Informal Collector role in
# demo mode. Do not add dummy collector numbers.
DEMO_OTP_PHONE=7708609156
